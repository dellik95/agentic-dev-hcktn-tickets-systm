# Copy to .env and fill in real values. Never commit .env.

# --- MySQL ---
DB_ROOT_PASSWORD=changeme-root
DB_NAME=ticketing
DB_USER=ticketing_app
DB_PASSWORD=changeme-app
DB_PORT=3306

# --- Backend / JWT ---
JWT_SIGNING_KEY=changeme-generate-a-long-random-value
JWT_ISSUER=ticketing-system
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- SMTP (email verification) ---
# Local/dev: point at the mailpit container. Prod/demo: relay1.dataart.com.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ticketing.local

# --- Frontend / links ---
# Base URL used to build the email-verification link.
FRONTEND_BASE_URL=http://localhost
